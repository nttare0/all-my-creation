{
  "name": "indexroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "node --watch server/main.mjs",
