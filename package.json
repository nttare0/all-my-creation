    "test:libsql": "node scripts/check-libsql.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16"
  }
}
