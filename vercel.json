{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": { "env": { "NODEJS_HELPERS": "0" } },
  "functions": { "api/index.mjs": { "includeFiles": "catalog/projects.sql" } },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
