{
  "name": "indexroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "node --watch server/main.mjs",
    "build": "npm run styles && node --check server/main.mjs && node --check public/enhance.js && node --check api/index.mjs && node scripts/build.mjs",
    "test": "node --test",
    "test:libsql": "node scripts/check-libsql.mjs",
    "styles": "tailwindcss -i styles/ui.css -o build/shadcn.css --minify",
    "prestart": "npm run styles",
    "predev": "npm run styles",
    "pretest": "npm run styles"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.75.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
